# Ignore everything
/*

# But not scripts
!scripts/
!R/
!R/**
!pipeline/
!pipeline/**
!config/
!config/analysis.yml
!_targets.R
!renv.lock
!Dockerfile
!docker-compose.yml
!.dockerignore
!.gitignore
!README.md

# Track historical source and archive documentation, but not archived data.
!legacy/
legacy/*
!legacy/README.md
!legacy/scripts/
!legacy/scripts/**

# Track reference provenance, but not large binary reference objects.
!references/
references/*
!references/README.md

# Historical untracked source files remain local-only in the archive.
legacy/scripts/download.sh
legacy/scripts/flow_pre.R
