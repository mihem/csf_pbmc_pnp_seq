# Ignore everything
/*

# But not scripts
!scripts/
!R/
!R/**
!pipeline/
!pipeline/**
!config/
!config/analysis.yml
!_targets.R
!renv.lock
!Dockerfile
!docker-compose.yml
!.dockerignore
!.gitignore
!README.md

# Track reference provenance, but not large binary reference objects.
!references/
references/*
!references/README.md

